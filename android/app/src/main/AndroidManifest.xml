<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV and Google TV (no touch screen, no Play services); the app's name and id come from
     app/build.gradle.kts -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- The remote's voice key: Android's speech recognition must be visible to the app (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:label="${label}"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Bolli"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="false">

        <!-- Back must reach dispatchKeyEvent as a key (predictive back, the
             default from Android 16 for this targetSdk, would take it) -->
        <!-- One instance, never rebuilt for a screen or input change: the page keeps its state -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density">
        </activity>

        <!-- Bolli YouTube's entries on the home screen: one for each built-in logo (src/youtube/ui/logo.ts: LOGOS), named
             org.bolli.logo. and the logo's id, with that logo's icon and banner. One is on at a time: the first as installed,
             another once it is chosen in Settings (MainActivity: setHomeLogo). The activity itself is no entry here.
             An entry is never taken out: a device that had it on would be left with none, and no way to start the app. A
             logo that goes keeps its entry, with the first logo's pictures. -->
        <activity-alias
            android:name="org.bolli.logo.red"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="${label}"
            android:icon="@drawable/icon"
            android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.shield"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_2"
            android:banner="@drawable/banner_2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.framed"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_4"
            android:banner="@drawable/banner_4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.badge"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_5"
            android:banner="@drawable/banner_5">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.steel"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_6"
            android:banner="@drawable/banner_6">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.rust"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_7"
            android:banner="@drawable/banner_7">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.glass"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_8"
            android:banner="@drawable/banner_8">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.fire"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_9"
            android:banner="@drawable/banner_9">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="org.bolli.logo.galaxy"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="${label}"
            android:icon="@drawable/icon_10"
            android:banner="@drawable/banner_10">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
